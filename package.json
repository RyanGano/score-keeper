{
  "name": "score-keeper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bootstrap": "^5.2.3",
    "react": "^19",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.10.2",
    "react-cookie": "^8",
    "react-dom": "^19",
    "styled-components": "^6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "genversion": "^3.2.0",
    "globals": "^17.14.0",
    "jsdom": "^30",
    "@typescript/native": "npm:typescript@^7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-npm.cjs",
    "start": "vite",
    "prebuild": "node scripts/ensure-npm.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "major": "npm version major",
    "minor": "npm version minor",
    "patch": "npm version patch",
    "version": "npm run store-version && git add src/version.ts",
    "store-version": "genversion --es6 --semi src/version.ts"
  }
}
